# Spotify app client ID (https://developer.spotify.com/dashboard)
CLIENT_ID=your-spotify-client-id
# Spotify app client secret
CLIENT_SECRET=your-spotify-client-secret
# Secret used to sign session JWTs (HS256); use a long random string
JWT_SECRET=change-me-to-a-long-random-string
# MongoDB connection URI
DB_CONNECT=mongodb+srv://user:password@cluster.example.mongodb.net/spotify-for-car
# Public origin of the app (Spotify redirect URI is <APP_URL>/api/auth/callback).
# Spotify rejects `localhost` redirect URIs; use the loopback IP locally.
APP_URL=http://127.0.0.1:3000
